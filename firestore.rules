rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVendorCode(code) {
      return code is string && code.matches('^LPK-[A-Z0-9]{6}$');
    }

    function isValidActivationCodeId(code) {
      return code is string &&
             code.size() >= 4 &&
             code.size() <= 48 &&
             code.matches('^[A-Z0-9][A-Z0-9_\\-]{3,47}$');
    }

    function isValidDeviceId(deviceId) {
      return deviceId is string &&
             deviceId.size() >= 4 &&
             deviceId.size() <= 128 &&
             deviceId.matches('^[a-zA-Z0-9_\\-:.]+$');
    }

    function isValidDeviceIdList(ids) {
      return ids is list &&
             ids.size() <= 2 &&
             (ids.size() == 0 || isValidDeviceId(ids[0])) &&
             (ids.size() < 2 || (isValidDeviceId(ids[1]) && ids[1] != ids[0]));
    }

    function existingDeviceList(data) {
      let arr = ('registeredDeviceIds' in data && data.registeredDeviceIds is list)
        ? data.registeredDeviceIds
        : [];
      let hasLegacy = ('registeredDeviceId' in data &&
                       data.registeredDeviceId is string &&
                       data.registeredDeviceId != '');
      return (hasLegacy && !(data.registeredDeviceId in arr))
        ? arr.concat([data.registeredDeviceId])
        : arr;
    }

    function isValidDeviceListGrowth(oldList, newList) {
      return isValidDeviceIdList(newList) &&
             (
               newList == oldList ||
               (oldList.size() < 2 &&
                newList.size() == oldList.size() + 1 &&
                newList.hasAll(oldList))
             );
    }

    function isLicenseDeveloper() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email in [
               'rendykurniawan0311@gmail.com',
               'farahrifa58@gmail.com'
             ];
    }

    function isValidLapakVendor(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidVendorCode(data.vendorCode) &&
             data.localSellerId is int && data.localSellerId >= 0 &&
             data.shopName is string && data.shopName.size() >= 1 && data.shopName.size() <= 100 &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 100 &&
             data.sellerStatus is string && data.sellerStatus in ['AKTIF', 'LIBUR', 'NONAKTIF'] &&
             data.adminFeeType is string && data.adminFeeType in ['FIXED', 'PERCENTAGE'] &&
             data.adminFeeValue is number && data.adminFeeValue >= 0 &&
             ((data.adminFeeType == 'PERCENTAGE' && data.adminFeeValue <= 100) ||
              (data.adminFeeType == 'FIXED' && data.adminFeeValue <= 10000000)) &&
             data.summaryTotalStock is int && data.summaryTotalStock >= 0 &&
             data.summaryTotalSold is int && data.summaryTotalSold >= 0 &&
             data.summaryUnpaidBalance is number && data.summaryUnpaidBalance >= 0 &&
             data.products is list && data.products.size() <= 100 &&
             (data.products.size() == 0 || data.products[0] is map) &&
             data.lastProcessedSubmissionId is string && data.lastProcessedSubmissionId.size() <= 128;
    }

    function isValidVendorAuthSecret(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.writeToken is string && data.writeToken.size() >= 12 && data.writeToken.size() <= 64 &&
             data.writeToken.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVendorSubmission(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidVendorCode(data.vendorCode) &&
             data.writeToken is string && data.writeToken.size() >= 12 && data.writeToken.size() <= 64 &&
             data.writeToken.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.status is string && data.status in ['PENDING', 'PROCESSED', 'REJECTED'] &&
             data.newProducts is list && data.newProducts.size() <= 50 &&
             (data.newProducts.size() == 0 || data.newProducts[0] is map) &&
             data.editedProducts is list && data.editedProducts.size() <= 50 &&
             (data.editedProducts.size() == 0 || data.editedProducts[0] is map) &&
             data.stockAdditions is list && data.stockAdditions.size() <= 50 &&
             (data.stockAdditions.size() == 0 || data.stockAdditions[0] is map) &&
             data.note is string && data.note.size() <= 200;
    }

    function isValidUserProfile(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128)) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
             isValidActivationCodeId(data.licenseCode) &&
             data.registeredDeviceId is string &&
             (data.registeredDeviceId == '' || isValidDeviceId(data.registeredDeviceId)) &&
             (!('registeredDeviceIds' in data) || isValidDeviceIdList(data.registeredDeviceIds)) &&
             data.active is bool;
    }

    function isValidDeviceRegistration(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.emailHint is string && data.emailHint.size() >= 3 && data.emailHint.size() <= 160 &&
             data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120 &&
             isValidActivationCodeId(data.licenseCode) &&
             data.active is bool;
    }

    function isValidUserVendorCatalog(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidVendorCode(data.vendorCode) &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 100 &&
             data.whatsappNumber is string && data.whatsappNumber.size() <= 40 &&
             data.address is string && data.address.size() <= 250 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.sellerStatus is string && data.sellerStatus in ['AKTIF', 'LIBUR', 'NONAKTIF'] &&
             data.writeToken is string && data.writeToken.size() >= 12 && data.writeToken.size() <= 64 &&
             data.writeToken.matches('^[a-zA-Z0-9_\\-]+$') &&
             (!('customAdminFeeType' in data) || (data.customAdminFeeType is string && data.customAdminFeeType in ['', 'FIXED', 'PERCENTAGE'])) &&
             (!('customAdminFeeValue' in data) || (data.customAdminFeeValue is number && data.customAdminFeeValue >= 0 && data.customAdminFeeValue <= 10000000)) &&
             data.sourceDeviceId is string && data.sourceDeviceId.size() <= 128 &&
             data.products is list && data.products.size() <= 100 &&
             (data.products.size() == 0 || data.products[0] is map);
    }

    function isValidLapakTransaction(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.transactionNumber is string && data.transactionNumber.size() >= 1 && data.transactionNumber.size() <= 64 &&
             data.timestampMillis is int && data.timestampMillis >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.totalItemsCount is int && data.totalItemsCount >= 0 &&
             data.cashReceived is number && data.cashReceived >= 0 &&
             data.changeGiven is number && data.changeGiven >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40 &&
             data.totalAdminProfit is number && data.totalAdminProfit >= 0 &&
             data.totalSellerShare is number && data.totalSellerShare >= 0 &&
             data.cancelled is bool &&
             data.cancellationReason is string && data.cancellationReason.size() <= 200 &&
             data.items is list && data.items.size() <= 100 &&
             (data.items.size() == 0 || data.items[0] is map);
    }

    function isValidLapakExpense(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.localExpenseId is int && data.localExpenseId >= 0 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.amount is number && data.amount >= 0 &&
             data.expenseDateMillis is int && data.expenseDateMillis >= 0 &&
             data.notes is string && data.notes.size() <= 300;
    }

    function isValidLapakSettlement(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.localPaymentId is int && data.localPaymentId >= 0 &&
             data.localSellerId is int && data.localSellerId >= 0 &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 100 &&
             data.vendorCode is string && data.vendorCode.size() <= 20 &&
             data.amount is number && data.amount >= 0 &&
             data.paymentDateMillis is int && data.paymentDateMillis >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.status is string && data.status in ['LUNAS', 'SEBAGIAN', 'BELUM_DIBAYAR'];
    }

    // --- 1. LAPAK VENDORS (Public by exact vendorCode for Web Penyetor; Owner Admin full control) ---
    match /lapak_vendors/{vendorCode} {
      allow get: if isValidVendorCode(vendorCode);
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidVendorCode(vendorCode) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().vendorCode == vendorCode &&
                       incoming().keys().hasAll([
                         'ownerUid', 'vendorCode', 'localSellerId', 'shopName', 'sellerName',
                         'sellerStatus', 'adminFeeType', 'adminFeeValue',
                         'summaryTotalStock', 'summaryTotalSold', 'summaryUnpaidBalance',
                         'products', 'lastProcessedSubmissionId', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'vendorCode', 'localSellerId', 'shopName', 'sellerName',
                         'sellerStatus', 'adminFeeType', 'adminFeeValue',
                         'summaryTotalStock', 'summaryTotalSold', 'summaryUnpaidBalance',
                         'products', 'lastProcessedSubmissionId', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLapakVendor(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidVendorCode(vendorCode) &&
                       existing().ownerUid == request.auth.uid &&
                       isValidLapakVendor(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().vendorCode == existing().vendorCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'localSellerId', 'shopName', 'sellerName', 'sellerStatus',
                         'adminFeeType', 'adminFeeValue',
                         'summaryTotalStock', 'summaryTotalSold', 'summaryUnpaidBalance',
                         'products', 'lastProcessedSubmissionId', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidVendorCode(vendorCode) &&
                       existing().ownerUid == request.auth.uid;

      // --- 2. PRIVATE AUTH SECRET ---
      match /private/{docId} {
        allow get: if isSignedIn() &&
                      isValidVendorCode(vendorCode) &&
                      docId == 'auth' &&
                      (resource == null || existing().ownerUid == request.auth.uid);

        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidVendorCode(vendorCode) &&
                         docId == 'auth' &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll(['ownerUid', 'writeToken', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['ownerUid', 'writeToken', 'createdAt', 'updatedAt']) &&
                         isValidVendorAuthSecret(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidVendorCode(vendorCode) &&
                         docId == 'auth' &&
                         existing().ownerUid == request.auth.uid &&
                         isValidVendorAuthSecret(incoming()) &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['writeToken', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidVendorCode(vendorCode) &&
                         docId == 'auth' &&
                         existing().ownerUid == request.auth.uid;
      }
    }

    // --- 3. VENDOR WEB SUBMISSIONS (Portal Web Penyetor) ---
    match /lapak_vendor_submissions/{submissionId} {
      allow get: if isSignedIn() &&
                    isValidId(submissionId) &&
                    existing().ownerUid == request.auth.uid;

      allow list: if isSignedIn() &&
                     existing().ownerUid == request.auth.uid;

      allow create: if isValidId(submissionId) &&
                       incoming().keys().hasAll([
                         'ownerUid', 'vendorCode', 'writeToken', 'status',
                         'newProducts', 'editedProducts', 'stockAdditions', 'note',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'vendorCode', 'writeToken', 'status',
                         'newProducts', 'editedProducts', 'stockAdditions', 'note',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidVendorSubmission(incoming()) &&
                       incoming().status == 'PENDING' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       exists(/databases/$(database)/documents/lapak_vendors/$(incoming().vendorCode)) &&
                       exists(/databases/$(database)/documents/lapak_vendors/$(incoming().vendorCode)/private/auth) &&
                       incoming().ownerUid == get(/databases/$(database)/documents/lapak_vendors/$(incoming().vendorCode)).data.ownerUid &&
                       incoming().writeToken == get(/databases/$(database)/documents/lapak_vendors/$(incoming().vendorCode)/private/auth).data.writeToken;

      allow update: if isSignedIn() &&
                       isValidId(submissionId) &&
                       existing().ownerUid == request.auth.uid &&
                       existing().status == 'PENDING' &&
                       isValidVendorSubmission(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().vendorCode == existing().vendorCode &&
                       incoming().writeToken == existing().writeToken &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().status in ['PROCESSED', 'REJECTED'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(submissionId) &&
                       existing().ownerUid == request.auth.uid;
    }

    // --- 4. ACTIVATION CODES (100% Synced with License Admin, Max 2 Devices) ---
    match /activation_codes/{codeId} {
      allow get: if isValidActivationCodeId(codeId);
      allow list: if isLicenseDeveloper();
      allow create: if isLicenseDeveloper() && isValidActivationCodeId(codeId);
      allow delete: if isLicenseDeveloper() && isValidActivationCodeId(codeId);

      // Case A: One-time claim 'available' -> 'used' with 1st device
      // Case B: Same owner adding 2nd authorized device (max 2 items in registeredDeviceIds)
      allow update: if isLicenseDeveloper() ||
                       (isSignedIn() &&
                        isValidActivationCodeId(codeId) &&
                        existing().status in ['available', 'AVAILABLE', 'Available'] &&
                        incoming().status == 'used' &&
                        incoming().usedByUid == request.auth.uid &&
                        incoming().usedByEmail is string &&
                        incoming().usedByEmail.size() >= 3 &&
                        incoming().usedByEmail.size() <= 160 &&
                        incoming().usedByBusinessName is string &&
                        incoming().usedByBusinessName.size() >= 1 &&
                        incoming().usedByBusinessName.size() <= 120 &&
                        isValidDeviceId(incoming().registeredDeviceId) &&
                        isValidDeviceIdList(incoming().registeredDeviceIds) &&
                        incoming().registeredDeviceIds.size() == 1 &&
                        incoming().registeredDeviceIds[0] == incoming().registeredDeviceId &&
                        incoming().usedAt is timestamp && incoming().usedAt <= request.time &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'status', 'usedByUid', 'usedByEmail', 'usedByBusinessName',
                          'registeredDeviceId', 'registeredDeviceIds', 'usedAt', 'updatedAt'
                        ])) ||
                       (isSignedIn() &&
                        isValidActivationCodeId(codeId) &&
                        existing().status in ['used', 'USED', 'Used'] &&
                        (('usedByUid' in existing() && existing().usedByUid == request.auth.uid) ||
                         (!('usedByUid' in existing()) &&
                          'usedByEmail' in existing() &&
                          'email' in request.auth.token &&
                          existing().usedByEmail == request.auth.token.email)) &&
                        incoming().status == existing().status &&
                        (!('usedByUid' in existing()) || incoming().usedByUid == existing().usedByUid) &&
                        isValidDeviceListGrowth(existingDeviceList(existing()), incoming().registeredDeviceIds) &&
                        incoming().registeredDeviceId is string &&
                        (incoming().registeredDeviceId == '' || incoming().registeredDeviceId in incoming().registeredDeviceIds) &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'registeredDeviceId', 'registeredDeviceIds', 'updatedAt'
                        ]));
    }

    // --- 5. USERS & USER-SCOPED REAL-TIME SUBCOLLECTIONS (MAX 2 DEVICES) ---
    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isLicenseDeveloper();
      allow list: if isLicenseDeveloper();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().active == true &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'businessName', 'licenseCode',
                         'registeredDeviceId', 'registeredDeviceIds', 'active', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'businessName', 'licenseCode',
                         'registeredDeviceId', 'registeredDeviceIds', 'active', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       isValidDeviceId(incoming().registeredDeviceId) &&
                       isValidDeviceIdList(incoming().registeredDeviceIds) &&
                       incoming().registeredDeviceIds.size() == 1 &&
                       incoming().registeredDeviceIds[0] == incoming().registeredDeviceId &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      // Multi-Device Lock (Max 2 HP) enforced server-side:
      // User can append up to 2 unique devices, never remove/overwrite existing ones or add a 3rd.
      // License Developer can freely reset registeredDeviceIds to [] / registeredDeviceId to "".
      allow update: if isLicenseDeveloper() ||
                       (isSignedIn() &&
                        request.auth.uid == userId &&
                        isValidUserProfile(incoming()) &&
                        (!('userId' in existing()) || incoming().userId == existing().userId) &&
                        incoming().licenseCode == existing().licenseCode &&
                        incoming().active == existing().active &&
                        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'businessName', 'email', 'registeredDeviceId', 'registeredDeviceIds', 'updatedAt'
                        ]) &&
                        ('registeredDeviceIds' in incoming()) &&
                        isValidDeviceListGrowth(existingDeviceList(existing()), incoming().registeredDeviceIds) &&
                        (incoming().registeredDeviceId == '' || incoming().registeredDeviceId in incoming().registeredDeviceIds));

      allow delete: if isLicenseDeveloper();

      // 5a. User Vendors, Products & Live Stock Catalog (Real-time 2-HP sync)
      match /vendors/{vendorCode} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidVendorCode(vendorCode) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().vendorCode == vendorCode &&
                         incoming().keys().hasAll([
                           'ownerUid', 'vendorCode', 'sellerName', 'whatsappNumber', 'address',
                           'notes', 'sellerStatus', 'writeToken', 'sourceDeviceId', 'products',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'ownerUid', 'vendorCode', 'sellerName', 'whatsappNumber', 'address',
                           'notes', 'sellerStatus', 'writeToken', 'customAdminFeeType',
                           'customAdminFeeValue', 'sourceDeviceId', 'products',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidUserVendorCatalog(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidVendorCode(vendorCode) &&
                         existing().ownerUid == request.auth.uid &&
                         isValidUserVendorCatalog(incoming()) &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().vendorCode == existing().vendorCode &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'sellerName', 'whatsappNumber', 'address', 'notes', 'sellerStatus',
                           'writeToken', 'customAdminFeeType', 'customAdminFeeValue',
                           'sourceDeviceId', 'products', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidVendorCode(vendorCode);
      }

      // 5b. User Transactions Subcollection
      match /transactions/{transactionDocId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionDocId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'ownerUid', 'transactionNumber', 'timestampMillis', 'totalAmount',
                           'totalItemsCount', 'cashReceived', 'changeGiven', 'paymentMethod',
                           'totalAdminProfit', 'totalSellerShare', 'cancelled', 'cancellationReason',
                           'items', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'ownerUid', 'transactionNumber', 'timestampMillis', 'totalAmount',
                           'totalItemsCount', 'cashReceived', 'changeGiven', 'paymentMethod',
                           'totalAdminProfit', 'totalSellerShare', 'cancelled', 'cancellationReason',
                           'items', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLapakTransaction(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionDocId) &&
                         existing().ownerUid == request.auth.uid &&
                         isValidLapakTransaction(incoming()) &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().transactionNumber == existing().transactionNumber &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cancelled', 'cancellationReason', 'totalAmount', 'totalItemsCount',
                           'cashReceived', 'changeGiven', 'paymentMethod',
                           'totalAdminProfit', 'totalSellerShare', 'items', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionDocId);
      }

      // 5c. User Operating Expenses Subcollection
      match /expenses/{expenseDocId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(expenseDocId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'ownerUid', 'localExpenseId', 'title', 'amount',
                           'expenseDateMillis', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'ownerUid', 'localExpenseId', 'title', 'amount',
                           'expenseDateMillis', 'notes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLapakExpense(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(expenseDocId) &&
                         existing().ownerUid == request.auth.uid &&
                         isValidLapakExpense(incoming()) &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amount', 'expenseDateMillis', 'notes', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(expenseDocId);
      }

      // 5d. User Seller Settlements Subcollection
      match /settlements/{settlementDocId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(settlementDocId) &&
                         incoming().ownerUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'ownerUid', 'localPaymentId', 'localSellerId', 'sellerName',
                           'vendorCode', 'amount', 'paymentDateMillis', 'paymentMethod',
                           'notes', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'ownerUid', 'localPaymentId', 'localSellerId', 'sellerName',
                           'vendorCode', 'amount', 'paymentDateMillis', 'paymentMethod',
                           'notes', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLapakSettlement(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(settlementDocId) &&
                         existing().ownerUid == request.auth.uid &&
                         isValidLapakSettlement(incoming()) &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'sellerName', 'vendorCode', 'amount', 'paymentDateMillis',
                           'paymentMethod', 'notes', 'status', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(settlementDocId);
      }
    }

    // --- 6. DEVICE REGISTRY (Exact-ID lookup for same-device auto-restore after reinstall) ---
    match /device_registry/{deviceId} {
      allow get: if isValidDeviceId(deviceId);
      allow list: if isLicenseDeveloper();

      allow create: if isSignedIn() &&
                       isValidDeviceId(deviceId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerUid', 'emailHint', 'businessName', 'licenseCode',
                         'active', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'emailHint', 'businessName', 'licenseCode',
                         'active', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidDeviceRegistration(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isLicenseDeveloper() ||
                       (isSignedIn() &&
                        isValidDeviceId(deviceId) &&
                        existing().ownerUid == request.auth.uid &&
                        isValidDeviceRegistration(incoming()) &&
                        incoming().ownerUid == existing().ownerUid &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'emailHint', 'businessName', 'licenseCode', 'active', 'updatedAt'
                        ]));

      allow delete: if isLicenseDeveloper() ||
                       (isSignedIn() && isValidDeviceId(deviceId) && existing().ownerUid == request.auth.uid);
    }
  }
}
