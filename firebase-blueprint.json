{
  "entities": {
    "LapakVendor": {
      "title": "LapakVendor",
      "description": "Public vendor portal document synced from the Lapak Kita Admin app for a specific consignor/seller.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "Firebase Auth UID of the Lapak Kita Admin who owns this vendor." },
        "vendorCode": { "type": "string", "description": "Unique vendor portal code in LPK-XXXXXX format matching the document ID." },
        "localSellerId": { "type": "integer", "description": "Local Room Seller ID on the Admin device." },
        "shopName": { "type": "string", "description": "Name of the consignment shop (Lapak)." },
        "sellerName": { "type": "string", "description": "Display name of the vendor/kitchen (Nama Dapur Penyetor)." },
        "sellerStatus": { "type": "string", "enum": ["AKTIF", "LIBUR", "NONAKTIF"] },
        "adminFeeType": { "type": "string", "enum": ["FIXED", "PERCENTAGE"] },
        "adminFeeValue": { "type": "number" },
        "summaryTotalStock": { "type": "integer" },
        "summaryTotalSold": { "type": "integer" },
        "summaryUnpaidBalance": { "type": "number" },
        "products": { "type": "array" },
        "lastProcessedSubmissionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "vendorCode", "localSellerId", "shopName", "sellerName",
        "sellerStatus", "adminFeeType", "adminFeeValue",
        "summaryTotalStock", "summaryTotalSold", "summaryUnpaidBalance",
        "products", "lastProcessedSubmissionId", "createdAt", "updatedAt"
      ]
    },
    "VendorAuthSecret": {
      "title": "VendorAuthSecret",
      "description": "Admin-only private secret document storing the writeToken used to authorize Web Penyetor submissions.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "writeToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "writeToken", "createdAt", "updatedAt"]
    },
    "VendorSubmission": {
      "title": "VendorSubmission",
      "description": "Write-authenticated submission from the public Web Penyetor containing new products, product edits, and daily stock deliveries.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "vendorCode": { "type": "string" },
        "writeToken": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSED", "REJECTED"] },
        "newProducts": { "type": "array" },
        "editedProducts": { "type": "array" },
        "stockAdditions": { "type": "array" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "vendorCode", "writeToken", "status",
        "newProducts", "editedProducts", "stockAdditions", "note",
        "createdAt", "updatedAt"
      ]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Activation code managed by License Admin (format RAFDEV-XXXX-XXXX) claimed once on account registration.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Uppercase activation code matching the document ID." },
        "status": { "type": "string", "enum": ["available", "used"] },
        "usedByUid": { "type": "string" },
        "usedByEmail": { "type": "string" },
        "usedByBusinessName": { "type": "string" },
        "registeredDeviceId": { "type": "string" },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Licensed Lapak Kita Admin account profile bound to a single registered device.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "licenseCode": { "type": "string" },
        "registeredDeviceId": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "email", "businessName", "licenseCode",
        "registeredDeviceId", "active", "createdAt", "updatedAt"
      ]
    },
    "DeviceRegistration": {
      "title": "DeviceRegistration",
      "description": "Exact-device-ID lookup document enabling same-device auto-restore after reinstall without exposing user lists.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "emailHint": { "type": "string" },
        "businessName": { "type": "string" },
        "licenseCode": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "emailHint", "businessName", "licenseCode",
        "active", "createdAt", "updatedAt"
      ]
    },
    "LapakTransactionRecord": {
      "title": "LapakTransactionRecord",
      "description": "User-scoped cloud-synced sales transaction record with itemized consignor revenue split and admin commission.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "transactionNumber": { "type": "string" },
        "timestampMillis": { "type": "integer" },
        "totalAmount": { "type": "number" },
        "totalItemsCount": { "type": "integer" },
        "cashReceived": { "type": "number" },
        "changeGiven": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "totalAdminProfit": { "type": "number" },
        "totalSellerShare": { "type": "number" },
        "cancelled": { "type": "boolean" },
        "cancellationReason": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "transactionNumber", "timestampMillis", "totalAmount",
        "totalItemsCount", "cashReceived", "changeGiven", "paymentMethod",
        "totalAdminProfit", "totalSellerShare", "cancelled", "cancellationReason",
        "items", "createdAt", "updatedAt"
      ]
    },
    "LapakExpenseRecord": {
      "title": "LapakExpenseRecord",
      "description": "User-scoped cloud-synced operating expense record for Lapak Kita financial ledger.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "localExpenseId": { "type": "integer" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "expenseDateMillis": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "localExpenseId", "title", "amount",
        "expenseDateMillis", "notes", "createdAt", "updatedAt"
      ]
    },
    "LapakSettlementRecord": {
      "title": "LapakSettlementRecord",
      "description": "User-scoped cloud-synced seller payout/settlement record tracking amounts paid to each consignor.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "localPaymentId": { "type": "integer" },
        "localSellerId": { "type": "integer" },
        "sellerName": { "type": "string" },
        "vendorCode": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDateMillis": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["LUNAS", "SEBAGIAN", "BELUM_DIBAYAR"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "localPaymentId", "localSellerId", "sellerName",
        "vendorCode", "amount", "paymentDateMillis", "paymentMethod",
        "notes", "status", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/lapak_vendors/{vendorCode}": {
      "schema": { "$ref": "#/entities/LapakVendor" },
      "description": "Vendor portal state synced by Admin and read by the corresponding vendor using their unique vendorCode."
    },
    "/lapak_vendors/{vendorCode}/private/{docId}": {
      "schema": { "$ref": "#/entities/VendorAuthSecret" },
      "description": "Private admin-only subcollection storing writeToken at docId='auth'."
    },
    "/lapak_vendor_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/VendorSubmission" },
      "description": "Vendor web portal submissions listened in real-time by the owning Admin."
    },
    "/activation_codes/{codeId}": {
      "schema": { "$ref": "#/entities/ActivationCode" },
      "description": "Activation codes generated by License Admin with status 'available' and transitioned to 'used' on registration."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Registered Admin profile with licenseCode, businessName, and Single Device Lock registeredDeviceId."
    },
    "/users/{userId}/transactions/{transactionDocId}": {
      "schema": { "$ref": "#/entities/LapakTransactionRecord" },
      "description": "User-owned sales transactions synced in real-time for financial reporting."
    },
    "/users/{userId}/expenses/{expenseDocId}": {
      "schema": { "$ref": "#/entities/LapakExpenseRecord" },
      "description": "User-owned operating expenses synced in real-time for financial reporting."
    },
    "/users/{userId}/settlements/{settlementDocId}": {
      "schema": { "$ref": "#/entities/LapakSettlementRecord" },
      "description": "User-owned seller payout settlements synced in real-time for consignor recap reports."
    },
    "/device_registry/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceRegistration" },
      "description": "Exact-ID device lookup enabling same-device auto-restore after reinstall without public user listing."
    }
  }
}
